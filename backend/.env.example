# Copy this file to .env and fill in your actual values.
# Never commit real passwords or secrets to version control.

# Database
DB_NAME=memory_layer
DB_USERNAME=memory_user
DB_PASSWORD=change_me_in_production
DB_PORT=5432

# Backend
DB_URL=jdbc:postgresql://localhost:5432/memory_layer

# JWT (required for authentication)
# Use a strong random secret, e.g. openssl rand -base64 32
JWT_SECRET=change-me-in-production-use-at-least-32-chars
JWT_EXPIRATION_MS=3600000
